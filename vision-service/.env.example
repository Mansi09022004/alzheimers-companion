# Copy to `.env` and fill real values. NEVER commit `.env`.

APP_ENV=development
PORT=8001

# InsightFace model pack (downloaded on first run, cached in ./models)
INSIGHTFACE_MODEL=buffalo_l
FACE_EMBEDDING_DIM=512

# Shared secret so only the Core API can call this service
VISION_SERVICE_TOKEN=replace-me-with-a-long-random-string
