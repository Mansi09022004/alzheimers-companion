# Copy to `.env` and fill real values. NEVER commit `.env`.

# --- App ---
APP_ENV=development
API_V1_PREFIX=/api/v1

# --- Database ---
# Local (docker compose): postgres runs on localhost:5432
DATABASE_URL=postgresql+psycopg://alz:alz_password@localhost:5432/alzheimers

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- LLM provider ---
# "fake" = deterministic offline embeddings/replies (no key, good for local dev).
# "gemini" = real API; requires GEMINI_API_KEY (https://aistudio.google.com/app/apikey).
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Vision service ---
VISION_SERVICE_URL=http://localhost:8001
VISION_SERVICE_TOKEN=dev-vision-token

# --- Notifications ---
EXPO_ACCESS_TOKEN=

# --- Maps ---
GOOGLE_MAPS_API_KEY=

# --- Notifications & scheduler ---
ENABLE_SCHEDULER=false
NOTIFICATION_PROVIDER=log
EXPO_ACCESS_TOKEN=
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Production CORS (comma-separated) ---
CORS_ORIGINS_RAW=
