# Copy to `.env` and fill real values. NEVER commit `.env`.

# --- App ---
APP_ENV=development
API_V1_PREFIX=/api/v1

# --- Database ---
# Local (docker compose): postgres runs on localhost:5432
DATABASE_URL=postgresql+psycopg://alz:alz_password@localhost:5432/alzheimers

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Google Sign-In ---
# OAuth client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# --- LLM provider ---
# "fake" = deterministic offline embeddings/replies (no key, good for local dev).
# "gemini" = real API; requires GEMINI_API_KEY (https://aistudio.google.com/app/apikey).
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Vision service ---
VISION_SERVICE_URL=http://localhost:8001
VISION_SERVICE_TOKEN=dev-vision-token

# --- Notifications & scheduler ---
ENABLE_SCHEDULER=false          # true in the container / prod
NOTIFICATION_PROVIDER=log       # "log" or "expo"
EXPO_ACCESS_TOKEN=              # optional
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Caregiver web push (SOS reaches the caregiver even with the dashboard closed) ---
# Generate a keypair: python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); v.save_key('vapid_private_key.pem')"
# then print the public key (see backend/app/services/notifications/webpush.py docstring).
VAPID_PRIVATE_KEY_PATH=vapid_private_key.pem
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:alerts@example.com

# --- Production CORS (comma-separated allowed origins) ---
CORS_ORIGINS_RAW=
