# Copy to `.env`. Expo inlines EXPO_PUBLIC_* vars at build time.
#
# Android emulator : http://10.0.2.2:8000
# iOS simulator    : http://localhost:8000
# Real phone       : http://<your-computer-LAN-IP>:8000   (phone on the same Wi-Fi)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
EXPO_PUBLIC_DASHBOARD_URL=http://localhost:5174
