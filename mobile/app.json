{
  "expo": {
    "name": "Alzheimer's Companion",
    "slug": "alzheimers-companion",
    "scheme": "alzcompanion",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Alzheimer's Companion uses the camera to help recognise family members."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Alzheimer's Companion uses the microphone so you can ask questions by voice."
        }
      ]
    ],
    "extra": {
      "note": "Set EXPO_PUBLIC_API_URL in mobile/.env. On a real phone use your computer's LAN IP, e.g. http://192.168.1.5:8000"
    }
  }
}
