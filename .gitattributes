# Normalize text line endings in the repo, check out native on each OS.
* text=auto eol=lf

# Binary files — never touch line endings.
*.pdf     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.onnx    binary
*.zip     binary
